@startuml
title <size:24>Kafka Publisher</size>

set separator none
top to bottom direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Component>

System_Boundary("EventingPlatform_boundary", "EventingPlatform", $tags="") {
  Container_Boundary("EventingPlatform.EventingPlatform_boundary", "EventingPlatform", $tags="") {
    Component(EventingPlatform.EventingPlatform.KafkaPublisher, "Kafka Publisher", $techn="Module", $descr="", $tags="", $link="")
    Component(EventingPlatform.EventingPlatform.Domain, "Domain", $techn="Module", $descr="", $tags="", $link="")
    Component(EventingPlatform.EventingPlatform.Protobuf, "Protobuf", $techn="Module", $descr="", $tags="", $link="")
    Component(EventingPlatform.EventingPlatform.Application, "Application", $techn="Module", $descr="", $tags="", $link="")
  }

}

Rel(EventingPlatform.EventingPlatform.Protobuf, EventingPlatform.EventingPlatform.Domain, "depends on", $techn="", $tags="", $link="")
Rel(EventingPlatform.EventingPlatform.Application, EventingPlatform.EventingPlatform.Domain, "depends on", $techn="", $tags="", $link="")
Rel(EventingPlatform.EventingPlatform.KafkaPublisher, EventingPlatform.EventingPlatform.Domain, "depends on", $techn="", $tags="", $link="")
Rel(EventingPlatform.EventingPlatform.KafkaPublisher, EventingPlatform.EventingPlatform.Protobuf, "depends on", $techn="", $tags="", $link="")
Rel(EventingPlatform.EventingPlatform.KafkaPublisher, EventingPlatform.EventingPlatform.Application, "depends on", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml